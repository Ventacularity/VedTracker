# Copy to .env.local for local dev, or set these in Vercel -> Settings -> Environment Variables.
# Upstash Redis (free tier is enough for this project)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# One shared secret for incoming updates.
# OwnTracks: use this as the HTTP Basic auth password.
# Sleep Focus Shortcuts: send it as the x-vedtracker-secret header.
INGEST_SECRET=

# Password for the private /admin page. Use a different value from INGEST_SECRET.
ADMIN_PASSWORD=
